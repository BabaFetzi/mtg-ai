# ============================================================================
# .env.production.example – Vorlage für die Produktions-Konfiguration von Grana
#
# So verwenden:
#   cp .env.production.example .env
# und anschließend alle mit  <...>  markierten Werte ersetzen.
#
# Das Backend lädt diese Datei automatisch (python-dotenv). Zusätzlich liest
# start.sh sie ein, um die Infra-Container (Postgres/Redis) zu konfigurieren.
# NIEMALS die echte .env ins Git committen (sie steht in .dockerignore/.gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# Datenbank (PostgreSQL-Container aus docker-compose.infra.yml)
# ----------------------------------------------------------------------------
# Diese drei Werte konfigurieren den Postgres-Container:
POSTGRES_USER=grana
POSTGRES_PASSWORD=<STARKES-DB-PASSWORT>
POSTGRES_DB=grana

# Verbindungs-URL, die das Backend nutzt. Muss zu den drei Werten oben passen.
# WICHTIG: Treiber "postgresql+asyncpg" (async), Host 127.0.0.1 (Container ist
# nur an localhost gebunden).
DATABASE_URL=postgresql+asyncpg://grana:<STARKES-DB-PASSWORT>@127.0.0.1:5432/grana

# ----------------------------------------------------------------------------
# Redis (Container aus docker-compose.infra.yml)
# ----------------------------------------------------------------------------
# Pflicht in Produktion: ohne Redis kein verteiltes Rate-Limiting / Usage-Limit.
REDIS_URL=redis://127.0.0.1:6379/0

# ----------------------------------------------------------------------------
# Auth / Sicherheit
# ----------------------------------------------------------------------------
# Langer, zufälliger Geheimschlüssel für JWT-Signierung.
# Erzeugen mit:  openssl rand -hex 32
JWT_SECRET_KEY=<64-HEX-ZEICHEN>

# Kommagetrennte Liste der Benutzernamen mit Admin-Rechten (optional).
ADMIN_USERNAMES=

# ----------------------------------------------------------------------------
# CORS / URLs  (PFLICHT in Produktion!)
# ----------------------------------------------------------------------------
# Kommagetrennte Liste der erlaubten Frontend-Domains. Ist diese Variable
# gesetzt, wird localhost NICHT mehr automatisch erlaubt (siehe main.py).
ALLOWED_ORIGINS=https://grana.example.com

# Basis-URL des Frontends -- wird für OAuth-Redirects nach erfolgreichem Login
# verwendet (routers/auth.py). Ohne abschließenden Slash.
FRONTEND_URL=https://grana.example.com

# ----------------------------------------------------------------------------
# Stripe (Zahlungen / Premium-Abo)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_PUBLISHABLE_KEY=<pk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_ID=<price_...>

# ----------------------------------------------------------------------------
# Google Gemini (KI-Features)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=<GEMINI-API-KEY>

# Modellnamen -- optional. Standard sind die rollenden "...-latest"-Aliase
# (gemini-flash-latest / gemini-flash-lite-latest), die immer aufs aktuelle
# Modell zeigen und darum nicht wegbrechen, wenn Google fest versionierte
# Modelle für neue Keys abschaltet. Nur setzen, wenn du ein bestimmtes Modell
# erzwingen willst:
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_LITE=gemini-flash-lite-latest

# ----------------------------------------------------------------------------
# OAuth-Login (optional – nur setzen, wenn Google/Discord-Login aktiv sein soll)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ----------------------------------------------------------------------------
# Laufzeit-Tuning (optional, sinnvolle Defaults in start.sh)
# ----------------------------------------------------------------------------
# Port, auf dem das Backend lauscht.
PORT=8001
# Anzahl der uvicorn-Worker-Prozesse (Redis-basiertes Limiting ist worker-sicher).
UVICORN_WORKERS=2
# Log-Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
