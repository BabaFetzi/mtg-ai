# ======================================================================
# Grana – Beispiel-Umgebungsvariablen
# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env ist in .gitignore und darf NIE committet werden.
# ======================================================================

# --- Gemini / KI (Rules Judge + Synergie-Scanner + Deck-Analyse) ---
# API-Key aus Google AI Studio. Unterstützt beide Formate: alt "AIza..." und
# neu "AQ....". Es findet KEINE Format-Validierung statt. Judge und Scanner
# nutzen denselben Key. Ohne Key sind die KI-Funktionen deaktiviert.
GEMINI_API_KEY=

# --- Betriebsmodus ---
# "development" (Standard) oder "production". In der Produktion verweigert die
# Anwendung den Start, wenn JWT_SECRET_KEY fehlt oder zu kurz ist -- eine
# Warnung reicht dort nicht, weil ein flüchtiger Schlüssel bei jedem Neustart
# alle Anmeldungen ungültig macht.
GRANA_ENV=development

# --- Auth ---
# PFLICHT in Produktion, mindestens 32 Zeichen. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- E-Mail-Versand (Passwort zurücksetzen) ---
# SMTP statt einer Anbieter-Bibliothek: Postmark, Resend, Brevo, Mailgun und
# jeder eigene Server sprechen SMTP. Ein Anbieterwechsel ist damit nur eine
# Änderung hier.
# Ohne Konfiguration wird die Mail lokal nur ins Log geschrieben (der
# Rücksetz-Link steht dann im Terminal). In Produktion schlägt der Versand
# stattdessen hörbar fehl, damit keine Mail stillschweigend verlorengeht.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absenderadresse, z. B. "Grana <noreply@deine-domain.tld>"
SMTP_FROM=
# starttls (Standard, Port 587), ssl (Port 465) oder none
SMTP_TLS_MODE=starttls
# Gültigkeitsdauer des Rücksetz-Links in Minuten.
PASSWORT_RESET_MINUTEN=60
# Kommagetrennte Admin-Benutzernamen (dürfen fremde Rollen setzen).
ADMIN_USERNAMES=

# --- Datenbank ---
# Leer lassen für lokale SQLite; für Produktion z.B.
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=
SQLITE_PATH=

# --- Redis (Rate-Limits & Nutzungslimits; optional, fail-open ohne Redis) ---
REDIS_URL=

# --- Stripe (Premium-Checkout) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
#
# WICHTIG: Diese Ereignisse müssen im Stripe-Dashboard für den Webhook
# ausgewählt sein (Developers -> Webhooks -> Endpunkt -> Events):
#
#   checkout.session.completed        schaltet Premium frei
#   customer.subscription.created     Abo-Status
#   customer.subscription.updated     Abo-Status  <-- ohne das kommt niemand
#                                     nach einem Zahlungsproblem zurück
#   customer.subscription.deleted     Abo beendet -> free
#   invoice.payment_failed            nur fürs Protokoll, stuft NICHT herab
#
# Die Rolle hängt am Abo-Status, nicht an einzelnen Fehlversuchen: active,
# trialing und past_due bedeuten Premium (Stripe versucht eine
# fehlgeschlagene Zahlung tagelang erneut, und meistens klappt sie),
# unpaid/canceled/incomplete bedeuten free.

# --- Premium-Preisanzeige (Fallback, falls STRIPE_PRICE_ID nicht gesetzt) ---
# Damit die Preisseite nicht "nicht verfügbar" zeigt. Kein Checkout, nur Anzeige.
PREMIUM_PRICE_DISPLAY=
PREMIUM_CURRENCY=CHF
PREMIUM_INTERVAL=month

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Sonstiges ---
FRONTEND_URL=http://localhost:5175
ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Fehlerüberwachung (optional, aber vor dem Start dringend empfohlen)
# ----------------------------------------------------------------------
# Ohne DSN werden Fehler nur ins Log geschrieben -- einen Ausfall bemerkst du
# dann erst, wenn sich jemand beschwert. Der DSN steht in Sentry unter
# Settings -> Projects -> <Projekt> -> Client Keys.
SENTRY_DSN=
# Anteil der Anfragen, für die zusätzlich Laufzeiten gemessen werden (0 = nur
# Fehler). Messungen kosten Kontingent, deshalb standardmässig aus.
SENTRY_TRACES_SAMPLE_RATE=0
# Erscheint in Sentry als Version -- hilft, einen Fehler einem Stand zuzuordnen.
GRANA_VERSION=

# ----------------------------------------------------------------------
# Sicherungen
# ----------------------------------------------------------------------
# Täglich per Cron, Rücksicherung mit --zuruecksichern:
#   0 3 * * *  cd /pfad/zur/app && python -m werkzeuge.sicherung >> sicherung.log 2>&1

# ----------------------------------------------------------------------
# Betrieb hinter einem Reverse-Proxy
# ----------------------------------------------------------------------
# Auf true setzen, wenn nginx/Caddy/Cloudflare davor steht. Dann wird die
# Adresse aus X-Forwarded-For gelesen. NICHT ohne Proxy einschalten: sonst
# kann jeder die Kopfzeile selbst setzen und die Drosselung umgehen.
TRUST_PROXY_HEADERS=false
# Welchem Proxy uvicorn glaubt (Standard: nur derselbe Rechner).
FORWARDED_ALLOW_IPS=127.0.0.1

# ----------------------------------------------------------------------
# Anzahl der Worker
# ----------------------------------------------------------------------
# Jeder Worker ist eine eigene Kopie der Anwendung mit eigener
# Ereignisschleife. Mehr Worker heisst mehr Durchsatz, aber auch mehr
# Arbeitsspeicher. Gemessen mit werkzeuge/lasttest.py (25 gleichzeitige
# Nutzer, 4 Kerne, Sammlungen bis 15000 Karten):
#
#   Worker   Durchsatz     Sammlung p95   Speicher
#   1        178 Anfr./s   587 ms         ~140 MB
#   2        291 Anfr./s   262 ms         ~280 MB
#   4        322 Anfr./s   236 ms         ~540 MB
#
# Von 1 auf 2 ist der Sprung gross, von 2 auf 4 bringt es nur noch 11
# Prozent bei doppeltem Speicher. Deshalb ist 2 der Standard. Auf einem
# grösseren Server lohnt sich die Anzahl der Kerne; unter 1 GB RAM sollte
# es bei 2 bleiben. Nachmessen statt raten:
#   python -m werkzeuge.lasttest --server http://127.0.0.1:8001
UVICORN_WORKERS=2
